# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "anon" (ou "publishable") — publique, protégée par la RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé "service_role" (ou "secret") — SERVEUR UNIQUEMENT, ne jamais l'exposer
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site (liens des emails, redirections Stripe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Paiement ---
# "mock" : paiement simulé (défaut) — "stripe" : Stripe Checkout + Connect
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
